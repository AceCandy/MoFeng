# ===================================================================
# Docker Compose 环境变量配置示例
# ===================================================================
#
# 使用说明：
# 1. 将此文件复制为 .env 文件: `cp .env.example .env`
# 2. 根据您的实际需求，仔细检查并修改以下配置项。
# 3. 使用内置 PostgreSQL 数据库快速启动，只需运行:
#    docker compose --profile postgres up -d
#
# ===================================================================

# -------------------------------------------------------------------
# A. 核心应用配置
# -------------------------------------------------------------------
# [必需] 应用对外暴露的网络端口
APP_PORT=6100

# [可选] 应用镜像仓库地址（用于 docker-compose 的 image 字段）
# 例如: woshidayingxiong77240/mofeng
IMAGE_REPO=woshidayingxiong77240/mofeng
# [必需] 用于 JWT token 等安全功能的加密密钥。
# 警告：为了生产环境的安全，请务必将其修改为一个长且随机的复杂字符串！
# 您可以使用此命令生成: openssl rand -hex 32
SECRET_KEY=your-secret-key-change-me-to-random-string

# [可选] 应用环境，设置为 "development" 可以启用更详细的调试日志
ENVIRONMENT=production

# [可选] 是否开启调试模式，生产环境中应始终为 "false"
DEBUG=false
# [可选] 控制应用日志级别，可选值：CRITICAL/ERROR/WARNING/INFO/DEBUG/NOTSET
LOGGING_LEVEL=INFO

# [可选] 允许的跨域来源，逗号分隔；生产环境必须改为具体前端域名（含协议），禁止使用 *
# 多个域名用英文逗号分隔，例如: https://mofeng.example.com,https://www.mofeng.example.com
CORS_ORIGINS=http://localhost:6100
# 是否允许 LLM/Embedding/TTS 指向私有/内网地址；仅内网部署时设为 true
ALLOW_PRIVATE_LLM_ENDPOINTS=false

# [可选] 远程版本检查配置（用于设置页“镜像版本”比较）
# 默认读取 GitHub 中 release-metadata/version-info.json。
VERSION_INFO_URL=https://raw.githubusercontent.com/woshidayingxiong77240/mofeng/main/release-metadata/version-info.json
# 可选备用地址（当 VERSION_INFO_URL 不可达时使用）
# VERSION_CHECK_URL=https://example.com/version.json


# -------------------------------------------------------------------
# B. 数据库配置
# -------------------------------------------------------------------
# PostgreSQL 数据库连接（主业务库，仅支持 PostgreSQL）

# ▼▼▼ 方案一：使用内置的 PostgreSQL 服务 ▼▼▼
# 启动命令: docker compose --profile postgres up -d
#
# 注意：以下变量由 docker-compose.yml 中的 `pg` 服务与应用容器共同使用。
POSTGRES_HOST=pg                 # 使用内置服务时，请勿修改此项
POSTGRES_PORT=5432
POSTGRES_USER=mofeng
POSTGRES_PASSWORD=your-database-password-change-me
POSTGRES_DATABASE=mofeng

# ▼▼▼ 方案二：连接到外部的 PostgreSQL 数据库 ▼▼
# 启动命令: docker compose up -d
# 可直接设置完整 DATABASE_URL；设置后它优先于 POSTGRES_*，部署脚本不会启动内置 pg。
# DATABASE_URL=postgresql+asyncpg://user:password@postgres.example.com:5432/mofeng
# POSTGRES_HOST=postgres.example.com
# POSTGRES_PORT=5432
# POSTGRES_USER=your-external-db-user
# POSTGRES_PASSWORD=your-external-db-password
# POSTGRES_DATABASE=your-external-db-name


# -------------------------------------------------------------------
# C. 初始化管理员账户
# -------------------------------------------------------------------
# migrate 后的显式 bootstrap 会按以下开关和凭据创建默认管理员。
BOOTSTRAP_CREATE_DEFAULT_ADMIN=true
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=your-admin-password-change-me
ADMIN_DEFAULT_EMAIL=admin@example.com


# -------------------------------------------------------------------
# D. 大语言模型 (LLM) 与 RAG 配置
# -------------------------------------------------------------------
# --- D1. 主要生成模型配置 ---
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_NAME=your-model-here
WRITER_CHAPTER_VERSION_COUNT=2

# --- D2. 嵌入模型配置 (用于 RAG 检索) ---
# 嵌入模型通过后台「模型设置」的向量模型配置（用户级 UserAIModel），不再使用环境变量。


# -------------------------------------------------------------------
# E. 向量检索配置 (用于 RAG，基于 pgvector，与主库共用 PostgreSQL)
# -------------------------------------------------------------------
# [可选] 是否启用向量检索（pgvector 扩展），默认开启
VECTOR_STORE_ENABLED=true
VECTOR_TOP_K_CHUNKS=5
VECTOR_TOP_K_SUMMARIES=3
VECTOR_CHUNK_SIZE=480
VECTOR_CHUNK_OVERLAP=120

# [可选] Redis 缓存连接串；启用 docker compose --profile redis 后填 redis://redis:6379/0
REDIS_URL=

# durable job worker：服务名只用于观测，进程实例 ID 会自动附加唯一 incarnation。
JOB_WORKER_NAME=mofeng-worker
JOB_WORKER_GENERATION=1
JOB_LEASE_SECONDS=120
JOB_HEARTBEAT_INTERVAL_SECONDS=30
JOB_WORKER_HEARTBEAT_INTERVAL_SECONDS=10
JOB_WORKER_POLL_INTERVAL_SECONDS=1
JOB_WORKER_HEALTH_STALE_SECONDS=45
JOB_EVENT_RETENTION_DAYS=14
JOB_EVENT_CLEANUP_INTERVAL_SECONDS=3600


# -------------------------------------------------------------------
# F. 可选服务与功能开关
# -------------------------------------------------------------------
# --- F1. SMTP 邮件发送配置 ---
# [可选] 用于发送注册验证、密码重置等邮件。
SMTP_SERVER=smtp.example.com
SMTP_PORT=465
SMTP_USERNAME=no-reply@example.com
SMTP_PASSWORD=your-smtp-password
EMAIL_FROM=墨风

# --- F2. 功能开关 ---
# 是否允许新用户注册
ALLOW_USER_REGISTRATION=false
# 是否启用 Linux.do 第三方登录
ENABLE_LINUXDO_LOGIN=false

# --- F3. Linux.do OAuth 配置 (如果启用) ---
# 仅当 ENABLE_LINUXDO_LOGIN=true 时需要配置。
LINUXDO_CLIENT_ID=your_client_id
LINUXDO_CLIENT_SECRET=your_client_secret
LINUXDO_REDIRECT_URI=https://your-domain.com/api/auth/linuxdo/register
LINUXDO_AUTH_URL=https://connect.linux.do/oauth2/authorize
LINUXDO_TOKEN_URL=https://connect.linux.do/oauth2/token
LINUXDO_USER_INFO_URL=https://connect.linux.do/api/user

