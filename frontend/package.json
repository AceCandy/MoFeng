{
  "name": "mofeng",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.15.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run type-check && npm run build-only && npm run build:budget",
    "preview": "vite preview",
    "build-only": "vite build",
    "build:budget": "node -e \"process.env.BUNDLE_BUDGET_WARN_JS_TOTAL_GZIP_KB=560; process.env.BUNDLE_BUDGET_MAX_JS_GZIP_KB=130; process.env.BUNDLE_BUDGET_MAX_JS_TOTAL_GZIP_KB=600; process.env.BUNDLE_BUDGET_WARN_CSS_GZIP_KB=24; process.env.BUNDLE_BUDGET_MAX_CSS_GZIP_KB=26; import('./scripts/check-bundle-budget.mjs')\"",
    "api:export": "cd ../backend && if [ -x .venv/bin/python ]; then .venv/bin/python -m app.openapi_export --output openapi.json; else python3 -m app.openapi_export --output openapi.json; fi",
    "api:generate:types": "openapi-typescript ../backend/openapi.json --alphabetize --output src/api/generated/schema.d.ts",
    "api:generate": "npm run api:export && npm run api:generate:types",
    "api:check:openapi": "cd ../backend && if [ -x .venv/bin/python ]; then .venv/bin/python -m app.openapi_export --check --output openapi.json; else python3 -m app.openapi_export --check --output openapi.json; fi",
    "api:check:types": "openapi-typescript ../backend/openapi.json --alphabetize --output src/api/generated/schema.d.ts --check",
    "api:check:ownership": "node --test scripts/check-api-contract-ownership.test.mjs && node scripts/check-api-contract-ownership.mjs",
    "api:check": "npm run api:check:openapi && npm run api:check:types && npm run api:check:ownership",
    "type-check": "vue-tsc --build",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@fontsource/noto-serif-sc": "^5.3.0",
    "@tanstack/vue-query": "^5.101.4",
    "@tiptap/extension-document": "^3.30.2",
    "@tiptap/extension-hard-break": "^3.30.2",
    "@tiptap/extension-paragraph": "^3.30.2",
    "@tiptap/extension-text": "^3.30.2",
    "@tiptap/extensions": "^3.30.2",
    "@tiptap/pm": "^3.30.2",
    "@tiptap/vue-3": "^3.30.2",
    "@types/marked": "^5.0.2",
    "@xstate/vue": "5.0.1",
    "dompurify": "^3.4.14",
    "marked": "^16.4.2",
    "naive-ui": "^2.45.2",
    "pinia": "^3.0.4",
    "vue": "^3.5.41",
    "vue-router": "^4.6.4",
    "xstate": "5.32.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.9.0",
    "eslint-plugin-vue": "^10.10.0",
    "jsdom": "^30.0.1",
    "openapi-typescript": "7.13.0",
    "postcss": "^8.5.26",
    "prettier": "3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  }
}
