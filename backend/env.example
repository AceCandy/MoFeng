# FastAPI 基础配置
SECRET_KEY=请替换为随机且复杂的字符串
ENVIRONMENT=development
DEBUG=true
LOGGING_LEVEL=INFO
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 天
# 允许的跨域来源，逗号分隔；生产环境必须改为具体域名，禁止使用 *
CORS_ORIGINS=http://localhost:6100,http://127.0.0.1:6100
# 是否允许 LLM/Embedding/TTS 指向私有/内网地址（如 192.168.x）；仅内网部署时设为 true
ALLOW_PRIVATE_LLM_ENDPOINTS=false

# --------------------------------------------
# 嵌入模型配置（RAG 检索）—— 通过后台「模型设置」的向量模型配置（用户级 UserAIModel），不再使用环境变量

# --------------------------------------------
# 向量检索（pgvector，与主库共用 PostgreSQL）
# --------------------------------------------
# 是否启用向量检索，默认开启；关闭后 RAG 检索将跳过
# VECTOR_STORE_ENABLED=true
VECTOR_TOP_K_CHUNKS=5
VECTOR_TOP_K_SUMMARIES=3
VECTOR_CHUNK_SIZE=480
VECTOR_CHUNK_OVERLAP=120

# Redis 连接串（留空禁用缓存；启用 Linux.do 登录时必须连接 Redis 6.2+）
# 本地开发可填 redis://localhost:6379/0；OAuth state 固定 300 秒且不会降级到进程内存储。
REDIS_URL=

# PostgreSQL 数据库连接（主业务库，仅支持 PostgreSQL）
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=mofeng
POSTGRES_PASSWORD=123456
POSTGRES_DATABASE=mofeng

# 管理员初始化账号（仅显式 db-bootstrap 执行，已有管理员不会被覆盖）
BOOTSTRAP_CREATE_DEFAULT_ADMIN=true
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=your-admin-password-change-me
ADMIN_DEFAULT_EMAIL=admin@example.com

# 默认 LLM 配置（首次启动写入 system_configs 表，之后可在后台修改）
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_NAME=gpt-4o-mini
WRITER_CHAPTER_VERSION_COUNT=2
WRITER_CHAPTER_WORD_LIMIT=3000
# WritingDesk statechart 需要 durable Chapter workflow；回滚旧前端时同步设为 false。

# Durable runtime production readiness baseline
JOB_PEAK_CONCURRENCY=20
JOB_LOAD_TEST_CONCURRENCY=40
JOB_PAYLOAD_MAX_BYTES=1048576
JOB_MAX_DURATION_SECONDS=1800
JOB_EVENT_RETENTION_DAYS=30
JOB_RETENTION_MAX_BYTES=107374182400
JOB_RECOVERY_SLO_SECONDS=300
JOB_QUEUE_AGE_ALERT_SECONDS=60
JOB_PROJECTION_LAG_ALERT_SECONDS=300

# SMTP 邮件发送配置（发送验证码用）
SMTP_SERVER=smtp.example.com
SMTP_PORT=465
SMTP_USERNAME=no-reply@example.com
SMTP_PASSWORD=your_smtp_password
EMAIL_FROM=小说生成器

# 注册与第三方登录开关
ALLOW_USER_REGISTRATION=true
ENABLE_LINUXDO_LOGIN=false

# Linux.do OAuth 配置信息（启用时请填写真实值；生产回调地址必须使用 HTTPS）
LINUXDO_CLIENT_ID=
LINUXDO_CLIENT_SECRET=
LINUXDO_REDIRECT_URI=https://your-domain.com/api/auth/linuxdo/register
LINUXDO_AUTH_URL=https://connect.linux.do/oauth2/authorize
LINUXDO_TOKEN_URL=https://connect.linux.do/oauth2/token
LINUXDO_USER_INFO_URL=https://connect.linux.do/api/user
